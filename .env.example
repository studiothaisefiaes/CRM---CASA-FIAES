# Copie para .env e ajuste. Nunca comite o .env. Os valores abaixo são exemplos, não segredos.
# O app (next) e o worker leem este mesmo arquivo; os scripts de backup também (sem executá-lo).

# --- Postgres (docker compose) ---
# Usuário do Postgres (o backup/restauração também usa; padrão crm)
PG_USER=crm
# Senha do Postgres; em produção gere uma forte (openssl rand -hex 32) e repita na DATABASE_URL
PG_PASSWORD=crm_local_dev
# Nome do banco do CRM
PG_DB=crm
# Porta do Postgres no host (só localhost; não expor no VPS)
PG_PORT=5433
# Conexão do app e do worker. Os testes trocam /crm por /crm_test e /crm_e2e sozinhos
DATABASE_URL=postgresql://crm:crm_local_dev@localhost:5433/crm

# --- Evolution API (WhatsApp) ---
# Porta da Evolution no host (só localhost)
EVOLUTION_PORT=8080
# Onde o app fala com a Evolution
EVOLUTION_URL=http://localhost:8080
# Chave global da Evolution (mínimo 16 caracteres)
EVOLUTION_API_KEY=troque-por-uma-chave-longa
# URL que a Evolution (dentro do Docker) usa para chegar no app
WEBHOOK_PUBLIC_URL=http://host.docker.internal:3000
# Segredo do webhook (cabeçalho x-webhook-secret; mínimo 24 caracteres)
WEBHOOK_SECRET=troque-por-um-segredo-longo

# --- App ---
# Endereço público do app (links de convite; contato padrão do push)
APP_URL=http://localhost:3000
# Assina as sessões (mínimo 32 caracteres; openssl rand -hex 32)
SESSION_SECRET=troque-por-um-segredo-longo-de-64-chars
# Liga o simulador de mensagens em /dev/simulador (só desenvolvimento; em produção fica sempre desligado)
DEV_TOOLS=false
# Proxies confiáveis na frente do app (Caddy = 1). Com 0 o x-forwarded-for é ignorado (dev local)
TRUSTED_PROXY_HOPS=1
# Fuso das datas. Opcional: o app e o worker já usam America/Bahia se faltar
# TZ=America/Bahia

# --- Backup e mídia ---
# Onde o scripts/backup.sh grava os backups (fora do repositório). Padrão: $HOME/backups/casa-fiaes-crm
# Caminho absoluto, sem $VAR nem ~ (o .env não expande variáveis).
# BACKUP_DIR=/home/deploy/backups/casa-fiaes-crm
# Pasta da mídia baixada do WhatsApp (entra no backup). Padrão: ./data/media (caminho absoluto, sem $VAR)
# MEDIA_DIR=/home/deploy/casa-fiaes-media
# Reserva do backup: se ele não achar o volume da sessão do WhatsApp pelos rótulos do docker compose, usa <projeto>_evolution_instances
# COMPOSE_PROJECT_NAME=<nome do projeto do docker compose>

# --- Push no celular (opcional) ---
# Sem as duas chaves o push fica desligado, sem erro. Gere com: npm run vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contato exigido pelo serviço de push (mailto: ou https:). Padrão: APP_URL
# VAPID_SUBJECT=mailto:contato@casafiaes.com.br

# --- Deploy (pm2) ---
# Raiz do projeto no VPS para o deploy/ecosystem.config.cjs. Padrão: /opt/crm
# CRM_DIR=/opt/crm

# --- Só testes e medições (não usar em produção) ---
# Pasta de build separada (servidor de e2e/medição rodando junto do dev). Padrão: .next
# NEXT_DIST_DIR=.next-e2e
# Porta do scripts/perf-fila-quadro.mjs. Padrão: 3190 (nunca 3000/3100)
# PERF_PORT=3190
# Pasta onde os specs do Playwright salvam prints (sem ela, não salvam)
# CF_SHOTS_DIR=/caminho/para/prints
