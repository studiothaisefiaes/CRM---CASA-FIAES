# Copie para .env e ajuste. Nunca comite o .env.
PG_USER=crm
PG_PASSWORD=crm_local_dev
PG_DB=crm
PG_PORT=5433
DATABASE_URL=postgresql://crm:crm_local_dev@localhost:5433/crm

EVOLUTION_PORT=8080
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-por-uma-chave-longa
# URL que a Evolution (dentro do Docker) usa para chegar no app
WEBHOOK_PUBLIC_URL=http://host.docker.internal:3000
WEBHOOK_SECRET=troque-por-um-segredo-longo

APP_URL=http://localhost:3000
SESSION_SECRET=troque-por-um-segredo-longo-de-64-chars
# Liga o simulador de mensagens (só desenvolvimento)
DEV_TOOLS=false
# Proxies confiáveis na frente do app (Caddy = 1). Com 0 o x-forwarded-for é ignorado.
TRUSTED_PROXY_HOPS=1
# Onde o scripts/backup.sh grava os backups (fora do repositório). Padrão: $HOME/backups/casa-fiaes-crm
# Caminho absoluto, sem $VAR nem ~ (o .env não expande variáveis).
# BACKUP_DIR=/home/deploy/backups/casa-fiaes-crm
# Pasta da mídia baixada do WhatsApp (entra no backup). Padrão: ./data/media (caminho absoluto, sem $VAR)
# MEDIA_DIR=/home/deploy/casa-fiaes-media
# Push no celular (opcional; sem as duas chaves o aviso fica desligado). Gere com: npm run vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@casafiaes.com.br
